[Unit]
Description=Bridge: phone chat for the Claude sessions in tmux (Tailscale only, via tailscale serve /bridge)
After=network-online.target

[Service]
EnvironmentFile=%h/bridge/.env
ExecStart=/usr/bin/python3 %h/bridge/server.py
Restart=always
RestartSec=5
MemoryMax=192M

[Install]
WantedBy=default.target
